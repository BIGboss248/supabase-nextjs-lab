# Sentry — public DSN for the browser and server SDKs.
# Copy the Client Keys (DSN) value from your Sentry project settings.
NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<orgId>.ingest.de.sentry.io/<projectId>

# Supabase local stack. Copy the values `npx supabase start` prints.
# These are not read by the CLI itself — it is driven by supabase/config.toml —
# and they are only for the Next.js app.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The publishable key is safe in a browser bundle. The secret key printed beside
# it is not, and this app never holds one: privileged writes go through
# security-definer functions granted to signed-in users (#2).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
